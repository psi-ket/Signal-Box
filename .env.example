# Copy to .env. Never commit .env.

# --- Agent providers ---
# Claude uses your local Claude Code login by default. Set this only to use an API key instead.
# ANTHROPIC_API_KEY=
# Optional model override for Claude sessions.
CLAUDE_MODEL=
# Enables the Gemini provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Enables the OpenAI API agent for host-billed sessions (participants can also bring their own key).
# OPENAI_API_KEY=
OPENAI_MODEL=
# Optional default models for the CLI agents (the UI lists what each CLI reports).
CODEX_MODEL=
GEMINI_CLI_MODEL=

# --- Room ---
COLAB_REPO=
COLAB_BASE_REF=
COLAB_HOST=127.0.0.1
COLAB_PORT=3003
# Extra allowed browser origins, comma separated (the tunnel URL is added automatically).
COLAB_ALLOWED_ORIGINS=
COLAB_LAN=0
COLAB_TUNNEL=0
COLAB_ALLOW_MOCK=0

# --- Behaviour ---
COLAB_VOTE_SECONDS=30
COLAB_OWNER_WINDOW_SECONDS=30
COLAB_DRIFT_INTERVAL_SECONDS=10
COLAB_CONFLICT_CHECK=1
COLAB_MAX_SESSIONS=6
COLAB_MAX_CONNECTIONS=32
COLAB_MAX_ROOMS=20
COLAB_LOG_LEVEL=info
