# Copy to .env. Never commit .env.

# ---------- Hub ----------
COLAB_PORT=3003
COLAB_HOST=127.0.0.1
# Public https URL when hosted (allows that origin and makes cookies Secure).
COLAB_PUBLIC_URL=
# Extra allowed browser origins, comma separated.
COLAB_ALLOWED_ORIGINS=
COLAB_DATA_DIR=
COLAB_DB_FILE=
# open | closed (closed still lets the very first account register)
COLAB_REGISTRATION=open
COLAB_ADMINS=
COLAB_REGISTER_PER_HOUR=10
COLAB_SECURE_COOKIES=0
# Behind a reverse proxy (Railway, Render, Fly, nginx): use X-Forwarded-For for rate limits.
COLAB_TRUST_PROXY=0
COLAB_MAX_ROOMS=100
COLAB_MAX_SESSIONS=8
COLAB_MAX_CONNECTIONS=200
COLAB_VOTE_SECONDS=30
COLAB_OWNER_WINDOW_SECONDS=30
COLAB_CONFLICT_CHECK=1
COLAB_LAN=0
COLAB_TUNNEL=0
# Demo / LAN only: run everyone's agents on the hub machine, allow local repo paths.
COLAB_HOST_RUNNER=0
COLAB_ALLOW_LOCAL_REPOS=0
COLAB_ALLOW_MOCK=0
COLAB_LOG_LEVEL=info

# ---------- Runner (read on the machine that runs `npm run runner`) ----------
SIGNALBOX_HUB=
SIGNALBOX_RUNNER_TOKEN=
# Agent credentials for runner-billed sessions (leave unset to use CLI logins).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=
CLAUDE_MODEL=
CODEX_MODEL=
GEMINI_CLI_MODEL=
