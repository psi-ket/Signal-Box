{
  "name": "agent-colab",
  "version": "1.0.0",
  "description": "Collaborative multi-agent coding supervision",
  "scripts": {
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "demo:setup": "tsx scripts/setup-demo.ts",
    "demo": "npm run build && tsx server/index.ts --host-runner --allow-local-repos",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "poc": "tsx scripts/poc-ask.ts",
    "live:e2e": "tsx scripts/live-e2e.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "runner": "tsx runner/index.ts"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "private": true
}
